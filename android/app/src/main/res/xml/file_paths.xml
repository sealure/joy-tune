<?xml version="1.0" encoding="utf-8"?>
<!-- FileProvider 可共享路径：暴露自动更新下载的 APK 目录给系统安装器跨进程读取。
     下载目录为 getApplicationSupportDirectory()（Android 返回 context.getFilesDir()，
     即 /data/user/0/<package>/files），故用 files-path 匹配其下的 updates/ 子目录。
     注意不要用 root-path：其根是文件系统根 /，而非应用目录。 -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <files-path name="updates" path="updates/" />
</paths>
